{
  "name": "decentraid-contracts",
  "version": "1.0.0",
  "description": "DecentraID Smart Contracts - Decentralized Identity, Access Control & NFT Assets",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "coverage": "npx hardhat coverage",
    "deploy:local": "npx hardhat run scripts/deploy-all.js",
