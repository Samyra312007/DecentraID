# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Solidity
[*.{sol}]
indent_size = 4

# Python
[*.{py}]
indent_size = 4
max_line_length = 88

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2

# JSON / YAML
[*.{json,yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefile
[Makefile]
indent_style = tab

# Dockerfile
[Dockerfile*]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# SQL
[*.sql]
indent_size = 4

# HTML / CSS
[*.{html,css}]
indent_size = 2

# Config files
[*.config.js]
indent_size = 2

[*.config.ts]
indent_size = 2

# Rust (if added later)
[*.rs]
indent_size = 4

# TOML
[*.toml]
indent_size = 4
